[importlinter]
root_packages =
    opspilot_common
    identity_service
    api_gateway
    settings_service
    mail_service
    privacy_service
    audit_service
    approval_service
    jira_connector
    agent_orchestrator
    reporting_service
    ops_service
include_external_packages = True

# Shared library: resilience and events must not depend on web frameworks.
[importlinter:contract:common-core-framework-free]
name = Resilience and event envelopes stay framework-free
type = forbidden
source_modules =
    opspilot_common.resilience
    opspilot_common.events.envelope
    opspilot_common.events.catalogue
    opspilot_common.events.ports
forbidden_modules =
    fastapi
    sqlalchemy
    aio_pika

# Hexagonal layers per service: outer layers may import inner ones, never the reverse.
[importlinter:contract:identity-layers]
name = identity-service hexagonal layers
type = layers
layers =
    identity_service.main
    identity_service.bootstrap
    identity_service.adapters
    identity_service.application
    identity_service.ports
    identity_service.domain

[importlinter:contract:identity-core-framework-free]
name = identity domain and application never import frameworks or drivers
type = forbidden
source_modules =
    identity_service.domain
    identity_service.application
    identity_service.ports
forbidden_modules =
    fastapi
    sqlalchemy
    httpx
    aio_pika
    argon2
    pyotp
    cryptography
    jwt

[importlinter:contract:gateway-layers]
name = api-gateway hexagonal layers
type = layers
layers =
    api_gateway.main
    api_gateway.bootstrap
    api_gateway.adapters
    api_gateway.application
    api_gateway.ports

