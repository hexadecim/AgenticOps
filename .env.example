# Copy to .env for local development. Never commit .env.
POSTGRES_PASSWORD=opspilot
RABBITMQ_DEFAULT_USER=opspilot
RABBITMQ_DEFAULT_PASS=opspilot
JWT_SECRET=change-me-dev-only-at-least-32-characters
FERNET_KEY=              # uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# First admin, created only when the user table is empty (identity-service).
BOOTSTRAP_ADMIN_EMAIL=admin@opspilot.local
BOOTSTRAP_ADMIN_PASSWORD=
